# ---- data -------------------------------------------------------------------
# Raw and intermediate data are reproducible from the acquisition scripts and are
# not redistributed here (see docs/data_sources.md for the licensing rationale).
data/raw/**
data/interim/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# The retrieval manifest is the exception. It contains no vendor data - only each
# file's source URL, retrieval timestamp, byte count and SHA-256 - and it is what
# lets a reader confirm that their own run of scripts/fetch_data.py produced the
# same bytes this analysis was run on. Excluding it would make the raw layer
# unverifiable, which is the opposite of the point.
!data/raw/_manifest.json
# Processed outputs are committed selectively; large binaries never are.
data/processed/*.parquet
*.h5
*.pkl

# ---- archived primary documents ---------------------------------------------
# The SEC filings are public records and freely redistributable, but they are third-
# party documents running to 14 MB and the repository's policy is provenance and
# reproduction rather than redistribution - the same rule the Cboe files follow.
# scripts/fetch_data.py re-downloads them from the EDGAR URLs in config/filings.yaml
# and data/raw/_manifest.json verifies them byte-for-byte by SHA-256.
#
# What IS committed is the evidence a reader needs without the documents: the
# register (references/filings/_index.json) and every verbatim quotation with the
# search pattern that found it (reports/tables/filing_terms.csv).
references/filings/*.htm
references/filings/*.html
references/filings/*.pdf
!references/filings/_index.json

# ---- secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- os / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- transfer artefacts ------------------------------------------------------
# Git bundles are used to move commits between the analysis environment and a
# machine with push access. They are a transport, never content.
*.bundle
